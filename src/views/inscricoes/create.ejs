<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: "Nova inscrição - " + evento.nome
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [{ label: 'Inscrições', path: '/inscricoes' }, { label: 'Nova inscrição' }] }) %>

            <h1 class="page-title">Nova inscrição</h1>
            <p class="page-subtitle">
              Campeonato: <%= evento.nome %>
            </p>
          </div>
        </div>

        <section class="page-content">
          <div class="card" style="max-width: 800px;">
            <form action="/eventos/<%= evento.id %>/inscricoes" method="POST" novalidate>
              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <%- include("_form") %>

              <div class="form-actions" style="margin-top: 24px; display: flex; gap: 12px;">
                <button type="submit" class="button button-primary">
                  Cadastrar competidor
                </button>

                <a
                  href="/eventos/<%= evento.id %>/inscricoes"
                  class="button button-outline"
                >
                  Cancelar
                </a>
              </div>
            </form>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
