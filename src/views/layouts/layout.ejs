<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> - Sistema Campeonato</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: sans-serif;
      background: #fff;
      color: #111;
      line-height: 1.5;
      min-height: 100vh;
    }

    .header {
      background: #111;
      color: #fff;
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 50px;
    }

    .header__brand {
      font-weight: 700;
      color: #fff;
      text-decoration: none;
    }

    .header__nav {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .header__link {
      color: #ccc;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .header__link:hover { color: #fff; }

    .header__user {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .header__username {
      color: #ccc;
      font-size: 0.85rem;
    }

    .main {
      max-width: 900px;
      margin: 1.5rem auto;
      padding: 0 1.5rem;
    }

    .flash {
      padding: 0.6rem 1rem;
      margin-bottom: 1rem;
      font-size: 0.9rem;
      border: 1px solid;
    }

    .flash--sucesso {
      border-color: #333;
      background: #f0f0f0;
    }

    .flash--erro {
      border-color: #999;
      background: #f5f5f5;
    }

    .btn {
      display: inline-block;
      padding: 0.4rem 0.8rem;
      border: 1px solid #111;
      background: #fff;
      color: #111;
      font-size: 0.85rem;
      cursor: pointer;
      text-decoration: none;
    }

    .btn:hover { background: #f0f0f0; }

    .btn--primary {
      background: #111;
      color: #fff;
    }

    .btn--primary:hover { background: #333; }

    .btn--danger { border-color: #666; color: #666; }
    .btn--danger:hover { background: #666; color: #fff; }

    .btn--sm { padding: 0.25rem 0.5rem; font-size: 0.8rem; }

    .btn--logout {
      background: none;
      border: none;
      color: #ccc;
      cursor: pointer;
      font-size: 0.85rem;
      padding: 0;
    }

    .btn--logout:hover { color: #fff; }

    .table-wrap {
      border: 1px solid #ddd;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      padding: 0.5rem 0.75rem;
      text-align: left;
      font-size: 0.9rem;
    }

    th {
      background: #f5f5f5;
      font-weight: 600;
      font-size: 0.8rem;
      text-transform: uppercase;
      border-bottom: 2px solid #ddd;
    }

    tr + tr { border-top: 1px solid #eee; }

    .form-card {
      border: 1px solid #ddd;
      padding: 1.5rem;
      max-width: 450px;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 0.3rem;
    }

    .form-group input {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid #ccc;
      font-size: 0.9rem;
    }

    .form-group input:focus {
      outline: none;
      border-color: #111;
    }

    .form-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .badge {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .badge--ativo { background: #eee; }
    .badge--inativo { background: #ddd; color: #666; }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .page-header h1 {
      font-size: 1.3rem;
      font-weight: 700;
    }

    .error-list {
      list-style: none;
      border: 1px solid #ccc;
      padding: 0.6rem 1rem;
      margin-bottom: 1rem;
      background: #f9f9f9;
    }

    .error-list li {
      font-size: 0.85rem;
      padding: 0.1rem 0;
    }

    .actions {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
    }

    .error-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 50vh;
      text-align: center;
    }

    .error-page__code {
      font-size: 4rem;
      font-weight: 800;
      line-height: 1;
      color: #ccc;
    }

    .error-page__msg {
      font-size: 1rem;
      color: #666;
      margin: 0.5rem 0 1.5rem;
    }
  </style>
</head>
<body>
  <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
  <header class="header">
    <a href="/" class="header__brand">Sistema Campeonato</a>
    <nav class="header__nav">
      <a href="/usuarios" class="header__link">Usuarios</a>
      <div class="header__user">
        <span class="header__username"><%= usuarioLogado.nome %></span>
        <form action="/logout" method="POST" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="btn--logout">Sair</button>
        </form>
      </div>
    </nav>
  </header>
  <% } %>

  <main class="main">
    <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
      <div class="flash flash--sucesso"><%= mensagemSucesso %></div>
    <% } %>
    <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
      <div class="flash flash--erro"><%= mensagemErro %></div>
    <% } %>

    <%- body %>
  </main>
</body>
</html>
