<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", { titulo: titulo }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <h1 class="page-title"><%= titulo %></h1>
            <% if (typeof subtitulo !== 'undefined' && subtitulo) { %>
              <p class="page-subtitle"><%= subtitulo %></p>
            <% } %>
          </div>
        </div>

        <section class="page-content">
          <%- include("../components/emptyState", {
            titulo: "Modulo em construcao",
            mensagem: "Este modulo sera implementado na proxima etapa.",
            acaoUrl: "/",
            acaoTexto: "Voltar para o Inicio"
          }) %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
