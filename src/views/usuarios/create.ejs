<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: titulo || "Novo Usuario"
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <h1 class="page-title">Novo Usuario</h1>
            <p class="page-subtitle">Cadastre um novo usuario para acessar o sistema.</p>
          </div>
        </div>

        <section class="page-content">
          <div class="form-card">
            <% if (typeof erros !== 'undefined' && erros && erros.length > 0) { %>
              <ul class="error-list">
                <% erros.forEach(function(erro) { %>
                  <li><%= erro %></li>
                <% }); %>
              </ul>
            <% } %>

            <form action="/usuarios" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div class="form-group">
                <label for="nome" class="form-label">Nome</label>
                <input type="text" id="nome" name="nome" class="form-control" value="<%= dados.nome %>" required>
              </div>

              <div class="form-group">
                <label for="email" class="form-label">E-mail</label>
                <input type="text" id="email" name="email" class="form-control" value="<%= dados.email %>" required>
              </div>

              <div class="form-group">
                <label for="senha" class="form-label">Senha</label>
                <input type="password" id="senha" name="senha" class="form-control" value="<%= dados.senha || '' %>" required>
              </div>

              <div class="form-group">
                <label for="confirmar_senha" class="form-label">Confirmar Senha</label>
                <input type="password" id="confirmar_senha" name="confirmar_senha" class="form-control" value="<%= dados.confirmar_senha || '' %>" required>
              </div>

              <div class="form-actions">
                <button type="submit" class="button button-primary">Cadastrar</button>
                <a href="/usuarios" class="button button-outline">Cancelar</a>
              </div>
            </form>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
