<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: "Categorias - " + evento.nome
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [{ label: 'Categorias' }] }) %>

            <h1 class="page-title">Categorias</h1>
            <p class="page-subtitle">
              Campeonato: <%= evento.nome %>
            </p>
          </div>

          <a
            href="/eventos/<%= evento.id %>/categorias/nova"
            class="button button-primary"
          >
            Nova categoria
          </a>
        </div>

        <section class="page-content">
          <% if (categorias && categorias.length > 0) { %>
            <div class="table-container">
              <table class="table table-categorias">
                <thead>
                  <tr>
                    <th>Categoria</th>
                    <th class="col-num">Atletas</th>
                    <th>Situação</th>
                    <th class="col-acoes">Ações</th>
                  </tr>
                </thead>

                <tbody>
                  <% categorias.forEach((categoria) => { %>
                    <% const temChave = Number(categoria.total_chaves) > 0; %>
                    <% const bloqueada = Number(categoria.total_inscricoes) > 0 || temChave; %>
                    <tr>
                      <td>
                        <strong class="categoria-nome"><%= categoria.nome %></strong>
                        <ul class="categoria-criterios" aria-label="Critérios da categoria">
                          <li title="Sexo"><%= formatarSexo(categoria.sexo) %></li>
                          <li title="Idade"><%= formatarIntervaloIdade(categoria) %></li>
                          <li title="Peso"><%= formatarIntervaloPeso(categoria) %></li>
                          <li title="Faixas"><%= formatarIntervaloFaixa(categoria) %></li>
                        </ul>
                      </td>

                      <td class="col-num">
                        <strong><%= categoria.total_inscricoes %></strong>
                      </td>

                      <td>
                        <div class="categoria-situacao">
                          <% if (temChave) { %>
                            <span class="badge badge-success">Chave gerada</span>
                          <% } else { %>
                            <span class="badge">Sem chave</span>
                          <% } %>

                          <% if (categoria.temSobreposicao) { %>
                            <span
                              class="badge badge-warning categoria-conflito"
                              title="Sobrepõe com: <%= categoria.sobreposicoes.join(', ') %>"
                            >
                              Sobreposição
                            </span>
                          <% } %>
                        </div>
                        <% if (categoria.temSobreposicao) { %>
                          <small class="categoria-conflito-detalhe">
                            Com: <%= categoria.sobreposicoes.join(', ') %>
                          </small>
                        <% } %>
                      </td>

                      <td class="col-acoes">
                        <div class="table-actions">
                          <a
                            href="/eventos/<%= evento.id %>/categorias/<%= categoria.id %>/editar"
                            class="button button-small button-outline"
                          >
                            Editar
                          </a>

                          <form
                            action="/eventos/<%= evento.id %>/categorias/<%= categoria.id %>/excluir"
                            method="POST"
                            style="display: inline;"
                            data-confirm="Deseja realmente excluir a categoria '<%= categoria.nome %>'?"
                          >
                            <input
                              type="hidden"
                              name="_csrf"
                              value="<%= csrfToken %>"
                            >

                            <button
                              type="submit"
                              class="button button-small button-danger"
                              <%- bloqueada ? 'title="Categoria com inscrições ou chaves não pode ser excluída"' : '' %>
                            >
                              Excluir
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <h2>Nenhuma categoria cadastrada</h2>
              <p>Cadastre as categorias de peso, idade e faixa para permitir as inscrições no campeonato.</p>
              <a
                href="/eventos/<%= evento.id %>/categorias/nova"
                class="button button-primary"
              >
                Cadastrar primeira categoria
              </a>
            </div>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
