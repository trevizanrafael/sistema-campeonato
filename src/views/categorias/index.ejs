<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: "Categorias - " + evento.nome
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [{ label: 'Categorias' }] }) %>

            <h1 class="page-title">Categorias</h1>
            <p class="page-subtitle">
              Campeonato: <%= evento.nome %>
            </p>
          </div>

          <a
            href="/eventos/<%= evento.id %>/categorias/nova"
            class="button button-primary"
          >
            Nova categoria
          </a>
        </div>

        <section class="page-content">
          <% if (categorias && categorias.length > 0) { %>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th>Categoria</th>
                    <th>Sexo</th>
                    <th>Idade</th>
                    <th>Peso</th>
                    <th>Faixas</th>
                    <th>Inscrições</th>
                    <th>Chave</th>
                    <th>Conflito</th>
                    <th>Ações</th>
                  </tr>
                </thead>

                <tbody>
                  <% categorias.forEach((categoria) => { %>
                    <tr>
                      <td>
                        <strong><%= categoria.nome %></strong>
                      </td>

                      <td>
                        <%= formatarSexo(categoria.sexo) %>
                      </td>

                      <td>
                        <%= formatarIntervaloIdade(categoria) %>
                      </td>

                      <td>
                        <%= formatarIntervaloPeso(categoria) %>
                      </td>

                      <td>
                        <%= formatarIntervaloFaixa(categoria) %>
                      </td>

                      <td>
                        <%= categoria.total_inscricoes %>
                      </td>

                      <td>
                        <%= Number(categoria.total_chaves) > 0 ? 'Sim' : 'Não' %>
                      </td>

                      <td>
                        <% if (categoria.temSobreposicao) { %>
                          <span
                            class="badge"
                            style="border: 1px solid #000; padding: 2px 6px; font-size: 0.75rem; background: #fff; cursor: help;"
                            title="Sobrepoe com: <%= categoria.sobreposicoes.join(', ') %>"
                          >
                            Sobreposição
                          </span>
                        <% } else { %>
                          <span style="color: #888; font-size: 0.85rem;">-</span>
                        <% } %>
                      </td>

                      <td>
                        <div class="table-actions">
                          <a
                            href="/eventos/<%= evento.id %>/categorias/<%= categoria.id %>/editar"
                            class="button button-small button-outline"
                          >
                            Editar
                          </a>

                          <form
                            action="/eventos/<%= evento.id %>/categorias/<%= categoria.id %>/excluir"
                            method="POST"
                            style="display: inline;"
                            data-confirm="Deseja realmente excluir a categoria '<%= categoria.nome %>'?"
                          >
                            <input
                              type="hidden"
                              name="_csrf"
                              value="<%= csrfToken %>"
                            >

                            <button
                              type="submit"
                              class="button button-small button-danger"
                              <%= (Number(categoria.total_inscricoes) > 0 || Number(categoria.total_chaves) > 0) ? 'title="Categoria com inscrições ou chaves não pode ser excluída"' : '' %>
                            >
                              Excluir
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <h2>Nenhuma categoria cadastrada</h2>
              <p>Cadastre as categorias de peso, idade e faixa para permitir as inscrições no campeonato.</p>
              <a
                href="/eventos/<%= evento.id %>/categorias/nova"
                class="button button-primary"
              >
                Cadastrar primeira categoria
              </a>
            </div>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
