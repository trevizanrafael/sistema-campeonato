<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: titulo || "Academias"
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <h1 class="page-title">Academias</h1>
            <p class="page-subtitle">Gerencie as academias participantes.</p>
          </div>

          <a href="/equipes/nova" class="button button-primary">
            Nova academia
          </a>
        </div>

        <section class="page-content">
          <% if (equipes && equipes.length > 0) { %>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th>Academia</th>
                    <th>Inscrições</th>
                    <th>Ações</th>
                  </tr>
                </thead>

                <tbody>
                  <% equipes.forEach((equipe) => { %>
                    <tr>
                      <td>
                        <strong><%= equipe.nome %></strong>
                      </td>

                      <td>
                        <%= equipe.total_inscricoes %>
                      </td>

                      <td>
                        <div class="table-actions">
                          <a
                            href="/equipes/<%= equipe.id %>/editar"
                            class="button button-small button-outline"
                          >
                            Editar
                          </a>

                          <form
                            action="/equipes/<%= equipe.id %>/excluir"
                            method="POST"
                            style="display: inline;"
                            data-confirm="Deseja excluir a academia <%= equipe.nome %>?"
                          >
                            <input
                              type="hidden"
                              name="_csrf"
                              value="<%= csrfToken %>"
                            >

                            <button
                              type="submit"
                              class="button button-small button-danger"
                            >
                              Excluir
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <h2>Nenhuma academia cadastrada</h2>
              <p>Cadastre as academias participantes para vincular aos competidores.</p>
              <a href="/equipes/nova" class="button button-primary">
                Cadastrar primeira academia
              </a>
            </div>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
