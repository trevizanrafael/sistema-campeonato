<div class="form-group">
  <label for="nome" class="form-label">
    Nome da equipe
  </label>

  <input
    type="text"
    id="nome"
    name="nome"
    class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
    value="<%= equipe.nome || '' %>"
    maxlength="200"
    required
    autofocus
  >

  <% if (erros.nome) { %>
    <p class="form-error"><%= erros.nome %></p>
  <% } %>
</div>
