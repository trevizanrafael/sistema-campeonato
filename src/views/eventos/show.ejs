<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: evento.nome || "Visão geral do campeonato"
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <% const base = '/eventos/' + evento.id; %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [] }) %>

            <h1 class="page-title"><%= evento.nome %></h1>

            <% if (evento.descricao) { %>
              <p class="page-subtitle">
                <%= evento.descricao %>
              </p>
            <% } %>
          </div>

          <% if (pode('eventos.gerenciar')) { %>
            <a
              href="<%= base %>/editar"
              class="button button-outline"
              id="botaoEditarCampeonato"
            >
              Editar dados
            </a>
          <% } %>
        </div>

        <section class="page-content">
          <%# Etapas do campeonato %>
          <ol class="etapas" aria-label="Etapas do campeonato">
            <% etapas.forEach(function(etapa) { %>
              <li class="etapa etapa-<%= etapa.status %>" <%- etapa.status === 'atual' ? 'aria-current="step"' : '' %>>
                <span class="etapa-marcador">
                  <% if (etapa.status === 'feito') { %>
                    <%- include("../partials/icone", { nome: 'check' }) %>
                  <% } else { %>
                    <%= etapa.numero %>
                  <% } %>
                </span>
                <span class="etapa-texto">
                  <strong><%= etapa.titulo %></strong>
                  <small><%= etapa.subtitulo %></small>
                </span>
              </li>
            <% }); %>
          </ol>

          <div class="painel-grid">
            <%# Próximo passo %>
            <article class="card proximo-passo" id="cartaoProximoPasso">
              <span class="painel-rotulo">Próximo passo</span>
              <h2><%= proximoPasso.titulo %></h2>
              <p><%= proximoPasso.texto %></p>
              <% if (proximoPasso.path) { %>
                <a
                  href="<%= base + proximoPasso.path %>"
                  class="button button-primary"
                  id="botaoProximoPasso"
                >
                  <%= proximoPasso.acao %>
                  <%- include("../partials/icone", { nome: 'seta' }) %>
                </a>
              <% } %>
            </article>

            <%# Pendências %>
            <article class="card pendencias" id="cartaoPendencias">
              <span class="painel-rotulo">Pendências</span>
              <% if (pendencias.length === 0) { %>
                <p class="pendencias-vazio">
                  <%- include("../partials/icone", { nome: 'check' }) %>
                  Tudo em ordem por aqui.
                </p>
              <% } else { %>
                <ul>
                  <% pendencias.forEach(function(pendencia) { %>
                    <li>
                      <a href="<%= base + pendencia.path %>">
                        <%- include("../partials/icone", { nome: 'alerta' }) %>
                        <span><%= pendencia.texto %></span>
                        <%- include("../partials/icone", { nome: 'seta' }) %>
                      </a>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </article>
          </div>

          <%# Atalhos para as áreas do campeonato (o menu lateral fica escondido no celular) %>
          <% if (atalhos.length > 0) { %>
            <nav class="atalhos-grid" aria-label="Áreas do campeonato">
              <% atalhos.forEach(function(atalho) { %>
                <a href="<%= base + atalho.path %>" class="card atalho-card" id="atalho-<%= atalho.icone %>">
                  <span class="atalho-icone"><%- include("../partials/icone", { nome: atalho.icone }) %></span>
                  <span class="atalho-texto">
                    <strong><%= atalho.titulo %></strong>
                    <small><%= atalho.resumo %></small>
                  </span>
                  <span class="atalho-seta"><%- include("../partials/icone", { nome: 'seta' }) %></span>
                </a>
              <% }); %>
            </nav>
          <% } %>

          <% if (pode('eventos.gerenciar')) { %>
          <section class="danger-zone">
            <h2>Excluir campeonato</h2>

            <p>
              Só é possível excluir um campeonato que ainda não possua categorias, inscrições ou resultados.
            </p>

            <form
              action="<%= base %>/excluir"
              method="POST"
              data-confirm="Deseja realmente excluir este campeonato?"
            >
              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <button type="submit" class="button button-danger" id="botaoExcluirCampeonato">
                Excluir campeonato
              </button>
            </form>
          </section>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
