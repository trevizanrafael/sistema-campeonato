<div class="form-group">
  <label for="nome" class="form-label">
    Nome
  </label>

  <input
    type="text"
    id="nome"
    name="nome"
    class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
    value="<%= evento.nome || '' %>"
    maxlength="200"
    required
    autofocus
  >

  <% if (erros.nome) { %>
    <p class="form-error"><%= erros.nome %></p>
  <% } %>
</div>

<div class="form-group">
  <label for="descricao" class="form-label">
    Descricao
  </label>

  <textarea
    id="descricao"
    name="descricao"
    class="form-control <%= erros.descricao ? 'is-invalid' : '' %>"
    rows="6"
    maxlength="5000"
  ><%= evento.descricao || '' %></textarea>

  <% if (erros.descricao) { %>
    <p class="form-error">
      <%= erros.descricao %>
    </p>
  <% } %>
</div>
