<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: titulo || "Campeonatos"
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <h1 class="page-title">Campeonatos</h1>
            <p class="page-subtitle"><%= pode('eventos.gerenciar') ? 'Gerencie os campeonatos cadastrados.' : 'Escolha o campeonato em que você vai trabalhar.' %></p>
          </div>

          <% if (pode('eventos.gerenciar')) { %>
            <a href="/eventos/novo" class="button button-primary">
              Novo campeonato
            </a>
          <% } %>
        </div>

        <section class="page-content">
          <form action="/eventos" method="GET" class="search-form">
            <input
              type="search"
              id="busca"
              name="busca"
              class="form-control"
              placeholder="Pesquisar por nome ou descrição"
              value="<%= typeof busca !== 'undefined' ? busca : '' %>"
            >

            <button type="submit" class="button button-outline">
              Pesquisar
            </button>

            <% if (typeof busca !== 'undefined' && busca) { %>
              <a href="/eventos" class="button button-outline">
                Limpar
              </a>
            <% } %>
          </form>

          <% if (eventos && eventos.length > 0) { %>
            <div class="table-container">
              <table class="table table-eventos">
                <thead>
                  <tr>
                    <th>Campeonato</th>
                    <th>Categorias</th>
                    <th>Inscrições</th>
                    <th class="col-hide-mobile">Criado em</th>
                    <th>Ações</th>
                  </tr>
                </thead>

                <tbody>
                  <% eventos.forEach((evento) => { %>
                    <tr>
                      <td class="col-campeonato">
                        <a href="/eventos/<%= evento.id %>" class="campeonato-card-titulo">
                          <strong><%= evento.nome %></strong>
                        </a>

                        <% if (evento.descricao) { %>
                          <p class="table-description">
                            <%= evento.descricao %>
                          </p>
                        <% } %>
                      </td>

                      <td class="col-num">
                        <strong><%= evento.total_categorias %></strong>
                      </td>

                      <td class="col-num">
                        <strong><%= evento.total_inscricoes %></strong>
                      </td>

                      <td class="col-hide-mobile">
                        <%= formatarData(evento.created_at) %>
                      </td>

                      <td class="col-acoes">
                        <div class="table-actions">
                          <a
                            href="/eventos/<%= evento.id %>"
                            class="button button-small button-outline button-abrir"
                          >
                            Abrir
                          </a>

                          <% if (pode('eventos.gerenciar')) { %>
                            <a
                              href="/eventos/<%= evento.id %>/editar"
                              class="button button-small button-outline"
                            >
                              Editar
                            </a>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <% if (typeof totalPaginas !== 'undefined' && totalPaginas > 1) { %>
              <%- include("../components/pagination", {
                paginacao: {
                  paginaAtual,
                  totalPaginas
                }
              }) %>
            <% } %>

          <% } else { %>
            <% if (typeof busca !== 'undefined' && busca) { %>
              <div class="empty-state">
                <h2>Nenhum resultado encontrado</h2>
                <p>Não encontramos campeonatos correspondentes a pesquisa.</p>
                <a href="/eventos" class="button button-outline">
                  Limpar pesquisa
                </a>
              </div>
            <% } else { %>
              <div class="empty-state">
                <h2>Nenhum campeonato cadastrado</h2>
                <% if (pode('eventos.gerenciar')) { %>
                  <p>Crie o primeiro campeonato para começar a cadastrar categorias e inscrições.</p>
                  <a href="/eventos/novo" class="button button-primary">
                    Criar primeiro campeonato
                  </a>
                <% } else { %>
                  <p>Peça para um organizador cadastrar o campeonato.</p>
                <% } %>
              </div>
            <% } %>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
