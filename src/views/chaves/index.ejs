<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: `${titulo}`
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [{ label: 'Chaves' }] }) %>
            <h1 class="page-title">Chaves de Luta</h1>
            <p class="page-subtitle">
              Gerenciamento e sorteio de chaves eliminatórias por categoria para <strong><%= evento.nome %></strong>.
            </p>
          </div>
        </div>

        <section class="page-content">
          <% if (!categorias || categorias.length === 0) { %>
            <div class="card empty-state">
              <h2>Nenhuma categoria cadastrada</h2>
              <% if (pode('categorias.gerenciar')) { %>
                <p>Cadastre categorias no campeonato antes de gerar as chaves de combate.</p>
                <a href="/eventos/<%= evento.id %>/categorias/nova" class="button button-primary">
                  Cadastrar primeira categoria
                </a>
              <% } else { %>
                <p>Este campeonato ainda não tem categorias. Aguarde o organizador configurar.</p>
              <% } %>
            </div>
          <% } else { %>
            <div class="table-container">
              <table class="table table-chaves">
                <thead>
                  <tr>
                    <th>Categoria</th>
                    <th class="col-num">Atletas</th>
                    <th>Situação</th>
                    <th class="col-acoes">Ações</th>
                  </tr>
                </thead>
                <tbody>
                  <% categorias.forEach(function(cat) { %>
                    <tr>
                      <td>
                        <strong class="categoria-nome"><%= cat.categoria_nome %></strong>
                        <ul class="categoria-criterios" aria-label="Critérios da categoria">
                          <li title="Sexo"><%= formatarSexo(cat.categoria_sexo) %></li>
                          <li title="Faixa">
                            <% if (cat.faixa_minima_nome) { %>
                              <%= cat.faixa_minima_nome %><%= cat.faixa_maxima_nome && cat.faixa_maxima_nome !== cat.faixa_minima_nome ? ` a ${cat.faixa_maxima_nome}` : '' %>
                            <% } else { %>
                              Qualquer faixa
                            <% } %>
                          </li>
                          <% if (cat.chave_tamanho) { %>
                            <li title="Tamanho da chave"><%= cat.chave_tamanho %> posições</li>
                          <% } %>
                        </ul>
                      </td>
                      <td class="col-num">
                        <strong><%= cat.total_confirmados %></strong>
                      </td>
                      <td>
                        <% if (!cat.chave_id) { %>
                          <% if (cat.total_confirmados < 2) { %>
                            <span class="badge badge-neutral">Inscritos insuficientes</span>
                            <small class="chave-nota">Mínimo 2 atletas confirmados</small>
                          <% } else { %>
                            <span class="badge badge-neutral">Sem chave</span>
                          <% } %>
                        <% } else if (cat.chave_status === 'NAO_INICIADA') { %>
                          <span class="badge badge-warning">Não iniciada</span>
                        <% } else if (cat.chave_status === 'EM_ANDAMENTO') { %>
                          <span class="badge badge-ativo">Em andamento</span>
                        <% } else if (cat.chave_status === 'FINALIZADA') { %>
                          <span class="badge badge-success">Finalizada</span>
                        <% } else { %>
                          <span class="badge badge-neutral"><%= cat.chave_status %></span>
                        <% } %>
                      </td>
                      <td class="col-acoes">
                        <% if (!cat.chave_id) { %>
                          <% if (cat.total_confirmados >= 2 && pode('chaves.gerar')) { %>
                            <form
                              action="/eventos/<%= evento.id %>/categorias/<%= cat.categoria_id %>/chave/gerar"
                              method="POST"
                              style="display: inline;"
                            >
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="button button-small button-primary">
                                Gerar chave
                              </button>
                            </form>
                          <% } else if (cat.total_confirmados >= 2) { %>
                            <small class="chave-nota">Aguardando organizador gerar</small>
                          <% } else { %>
                            <span class="chave-nota">—</span>
                          <% } %>
                        <% } else { %>
                          <a
                            href="/eventos/<%= evento.id %>/chaves/<%= cat.chave_id %>"
                            class="button button-small button-outline"
                          >
                            Abrir chave
                          </a>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
