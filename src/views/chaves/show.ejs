<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <%- include("../partials/head", {
      titulo: `${categoria ? categoria.nome : chave.nome} - ${evento.nome}`
    }) %>
    <link rel="stylesheet" href="/css/bracket.css">
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <div style="margin-bottom: 8px;">
              <a href="/eventos/<%= evento.id %>/chaves" class="button button-small button-outline">
                &larr; Voltar para as chaves
              </a>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
              <h1 class="page-title"><%= categoria ? categoria.nome : chave.nome %></h1>
              <% if (chave.status === 'NAO_INICIADA') { %>
                <span class="badge badge-warning">Nao iniciada</span>
              <% } else if (chave.status === 'EM_ANDAMENTO') { %>
                <span class="badge badge-ativo">Em andamento</span>
              <% } else if (chave.status === 'FINALIZADA') { %>
                <span class="badge badge-success">Finalizada</span>
              <% } %>
            </div>
            <p class="page-subtitle">
              Evento: <strong><%= evento.nome %></strong> | Chave eliminatoria de <strong><%= chave.tamanho %> posicoes</strong>
            </p>
          </div>

          <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <% if (chave.status === 'NAO_INICIADA') { %>
              <form
                action="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/sortear"
                method="POST"
                style="display: inline;"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button
                  type="submit"
                  class="button button-outline"
                  onclick="return confirm('Deseja sortear novamente os competidores desta chave?');"
                >
                  Sortear novamente
                </button>
              </form>

              <form
                action="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/iniciar"
                method="POST"
                style="display: inline;"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button
                  type="submit"
                  class="button button-primary"
                  onclick="return confirm('Deseja iniciar esta chave? A distribuicao ficara bloqueada e os byes avancarao automaticamente.');"
                >
                  Iniciar chave
                </button>
              </form>

              <form
                action="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/excluir"
                method="POST"
                style="display: inline;"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button
                  type="submit"
                  class="button button-danger"
                  onclick="return confirm('Tem certeza de que deseja excluir esta chave?');"
                >
                  Excluir chave
                </button>
              </form>
            <% } else if (chave.status === 'EM_ANDAMENTO') { %>
              <% if (todasFinalizadas) { %>
                <a
                  href="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/finalizar"
                  class="button button-primary"
                >
                  Finalizar categoria
                </a>
              <% } else { %>
                <span class="badge badge-neutral" style="padding: 8px 12px; font-size: 13px;">
                  Chave bloqueada para alteracoes estruturais
                </span>
              <% } %>
            <% } else if (chave.status === 'FINALIZADA') { %>
              <form
                action="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/reabrir"
                method="POST"
                style="display: inline;"
                data-confirm="Ao reabrir a categoria, os pontos de colocação serão removidos. Os resultados das lutas e pontos por vitória serão mantidos. Deseja continuar?"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button
                  type="submit"
                  class="button button-outline"
                >
                  Reabrir categoria
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <section class="page-content">
          <% if (chave.status === 'FINALIZADA') { %>
            <div class="card" style="margin-bottom: 24px; border-left: 4px solid #111;">
              <div style="margin-bottom: 16px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-text-muted);">
                  Categoria finalizada
                </span>
                <h2 style="margin: 4px 0; font-size: 18px;">Pódio Oficial</h2>
                <p style="margin: 0; font-size: 13px; color: var(--color-text-muted);">
                  <%= chave.colocacao_editada_manualmente ? 'Colocações editadas manualmente' : 'Colocações calculadas automaticamente' %>
                </p>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                <% if (chave.primeiro_lugar_nome) { %>
                  <div class="card" style="padding: 12px 16px; background: #fafafa; border-radius: 4px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #111; color: #fff; padding: 2px 6px; border-radius: 2px;">
                      1º lugar
                    </span>
                    <div style="margin-top: 6px;">
                      <strong style="display: block; font-size: 15px;"><%= chave.primeiro_lugar_nome %></strong>
                      <small style="color: var(--color-text-muted);"><%= chave.primeiro_lugar_equipe_nome || 'Sem equipe' %></small>
                    </div>
                  </div>
                <% } %>

                <% if (chave.segundo_lugar_nome) { %>
                  <div class="card" style="padding: 12px 16px; background: #fafafa; border-radius: 4px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #555; color: #fff; padding: 2px 6px; border-radius: 2px;">
                      2º lugar
                    </span>
                    <div style="margin-top: 6px;">
                      <strong style="display: block; font-size: 15px;"><%= chave.segundo_lugar_nome %></strong>
                      <small style="color: var(--color-text-muted);"><%= chave.segundo_lugar_equipe_nome || 'Sem equipe' %></small>
                    </div>
                  </div>
                <% } %>

                <% if (chave.terceiro_lugar_nome) { %>
                  <div class="card" style="padding: 12px 16px; background: #fafafa; border-radius: 4px;">
                    <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #888; color: #fff; padding: 2px 6px; border-radius: 2px;">
                      3º lugar
                    </span>
                    <div style="margin-top: 6px;">
                      <strong style="display: block; font-size: 15px;"><%= chave.terceiro_lugar_nome %></strong>
                      <small style="color: var(--color-text-muted);"><%= chave.terceiro_lugar_equipe_nome || 'Sem equipe' %></small>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>

          <p class="bracket-mobile-tip">
            Deslize horizontalmente para visualizar as proximas rodadas.
          </p>

          <div class="bracket-scroll">
            <div
              class="bracket"
              id="bracket"
              style="--round-count: <%= rodadas.length %>; min-height: <%= alturaMinima %>px;"
            >
              <svg
                class="bracket-connections"
                id="bracketConnections"
                aria-hidden="true"
              ></svg>

              <% rodadas.forEach(function(rodada) { %>
                <section class="bracket-round">
                  <h2 class="bracket-round-title">
                    <%= rodada.nome %>
                  </h2>

                  <div class="bracket-round-matches">
                    <% rodada.lutas.forEach(function(luta) { %>
                      <article
                        class="match-card match-<%= luta.status.toLowerCase() %>"
                        id="match-<%= luta.id %>"
                        data-match-id="<%= luta.id %>"
                        data-next-match-id="<%= luta.proxima_luta_id || '' %>"
                        data-status="<%= luta.status %>"
                      >
                        <div class="match-header">
                          <span>LUTA <%= luta.posicao %></span>
                          <span class="match-status">
                            <% if (luta.status === 'FINALIZADA') { %>
                              Finalizada
                            <% } else if (luta.status === 'PRONTA') { %>
                              Pronta
                            <% } else if (luta.status === 'CANCELADA') { %>
                              Cancelada
                            <% } else { %>
                              Aguardando
                            <% } %>
                          </span>
                        </div>

                        <!-- Competidor 1 -->
                        <div class="match-competitor <%= luta.competidor1.vencedor ? 'winner' : '' %> <%= luta.competidor1.tipo !== 'COMPETIDOR' ? 'placeholder' : '' %>">
                          <% if (luta.competidor1.seed) { %>
                            <span class="competitor-seed" title="Seed <%= luta.competidor1.seed %>">
                              <%= luta.competidor1.seed %>
                            </span>
                          <% } %>

                          <div class="competitor-info">
                            <strong><%= luta.competidor1.nome %></strong>
                            <% if (luta.competidor1.equipe) { %>
                              <small><%= luta.competidor1.equipe %></small>
                            <% } %>
                          </div>

                          <% if (luta.placar_1 !== null && luta.placar_1 !== undefined) { %>
                            <strong class="competitor-score"><%= luta.placar_1 %></strong>
                          <% } %>
                        </div>

                        <!-- Competidor 2 -->
                        <div class="match-competitor <%= luta.competidor2.vencedor ? 'winner' : '' %> <%= luta.competidor2.tipo !== 'COMPETIDOR' ? 'placeholder' : '' %>">
                          <% if (luta.competidor2.seed) { %>
                            <span class="competitor-seed" title="Seed <%= luta.competidor2.seed %>">
                              <%= luta.competidor2.seed %>
                            </span>
                          <% } %>

                          <div class="competitor-info">
                            <strong><%= luta.competidor2.nome %></strong>
                            <% if (luta.competidor2.equipe) { %>
                              <small><%= luta.competidor2.equipe %></small>
                            <% } %>
                          </div>

                          <% if (luta.placar_2 !== null && luta.placar_2 !== undefined) { %>
                            <strong class="competitor-score"><%= luta.placar_2 %></strong>
                          <% } %>
                        </div>

                        <% if (luta.status === 'FINALIZADA') { %>
                          <% if (luta.tipo_resultado === 'BYE') { %>
                            <div class="match-result-tag">
                              Avanço por BYE
                            </div>
                          <% } else if (chave.status === 'EM_ANDAMENTO') { %>
                            <% if (luta.proximaFinalizada) { %>
                              <div style="margin-top: 8px; text-align: center;">
                                <span style="font-size: 11px; color: var(--color-text-muted); display: block; padding: 4px 6px; background: #f0f0f0; border: 1px solid var(--color-border); border-radius: 2px;">
                                  Resultado bloqueado — próxima luta finalizada
                                </span>
                              </div>
                            <% } else { %>
                              <div style="margin-top: 8px; display: flex; gap: 6px; justify-content: center;">
                                <a
                                  href="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/lutas/<%= luta.id %>/resultado/editar"
                                  class="button button-small button-outline"
                                  style="flex: 1; padding: 3px 6px; font-size: 11px; text-transform: uppercase; font-weight: 600; text-align: center;"
                                >
                                  Corrigir
                                </a>
                                <form
                                  action="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/lutas/<%= luta.id %>/resultado/anular"
                                  method="POST"
                                  style="flex: 1; margin: 0;"
                                  data-confirm="Deseja anular este resultado? O avanço e os pontos serão removidos."
                                >
                                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                  <button
                                    type="submit"
                                    class="button button-small button-danger"
                                    style="width: 100%; padding: 3px 6px; font-size: 11px; text-transform: uppercase; font-weight: 600; text-align: center;"
                                  >
                                    Anular
                                  </button>
                                </form>
                              </div>
                            <% } %>
                          <% } %>
                        <% } %>

                        <% if (chave.status === 'EM_ANDAMENTO' && luta.status === 'PRONTA') { %>
                          <div style="margin-top: 8px; text-align: center;">
                            <a
                              href="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/lutas/<%= luta.id %>/resultado"
                              class="button button-small"
                              style="width: 100%; padding: 4px 8px; font-size: 11px; text-transform: uppercase; font-weight: 600; display: block; text-align: center;"
                            >
                              Lançar resultado
                            </a>
                          </div>
                        <% } %>
                      </article>
                    <% }); %>
                  </div>
                </section>
              <% }); %>
            </div>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
    <script src="/js/bracket.js" defer></script>
  </body>
</html>
