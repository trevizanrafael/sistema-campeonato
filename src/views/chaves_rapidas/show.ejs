<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: `${chaveRapida.nome} - Chave Rápida - ${evento.nome}`,
      pagina: "chave"
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>
        <% const chaveIniciada = (chaveRapida.status === 'EM_ANDAMENTO' || chaveRapida.status === 'FINALIZADA' || chaveRapida.chave_status === 'EM_ANDAMENTO' || chaveRapida.chave_status === 'FINALIZADA'); %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [{ label: 'Chaves', path: '/chaves' }, { label: chaveRapida.nome }] }) %>
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
              <h1 class="page-title"><%= chaveRapida.nome %></h1>
              <span class="badge badge-warning" style="font-weight: 700;">Chave Rápida</span>
              <% if (chaveRapida.chave_id) { %>
                <% if (chaveRapida.chave_status === 'NAO_INICIADA') { %>
                  <span class="badge badge-warning">Chave gerada (não iniciada)</span>
                <% } else if (chaveRapida.chave_status === 'EM_ANDAMENTO') { %>
                  <span class="badge badge-ativo">Em andamento</span>
                <% } else if (chaveRapida.chave_status === 'FINALIZADA') { %>
                  <span class="badge badge-success">Finalizada</span>
                <% } %>
              <% } else { %>
                <span class="badge badge-neutral">Sem chave gerada</span>
              <% } %>
            </div>
            <p class="page-subtitle">
              Campeonato: <strong><%= evento.nome %></strong> | Inscrição avulsa rápida na mesa
            </p>
          </div>

          <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <a
              href="/eventos/<%= evento.id %>/chaves"
              class="button button-outline"
              id="btnVoltarChavesRapida"
              title="Voltar para a listagem de chaves"
            >
              <%- include("../partials/icone", { nome: 'voltar' }) %>
              Voltar para as chaves
            </a>

            <% if (chaveRapida.chave_id) { %>
              <a href="/eventos/<%= evento.id %>/chaves/<%= chaveRapida.chave_id %>" class="button button-primary">
                Abrir Chave de Lutas
              </a>
              <% if (chaveRapida.chave_status === 'FINALIZADA') { %>
                <button
                  type="button"
                  class="button button-outline btn-abrir-modal-print"
                  id="btnImprimirChaveRapida"
                  data-url="/eventos/<%= evento.id %>/chaves/<%= chaveRapida.chave_id %>"
                  data-nome="<%= chaveRapida.nome %>"
                  title="Opções de impressão (Chave finalizada)"
                >
                  <%- include("../partials/icone", { nome: 'documento' }) %> Imprimir Chave (PDF)
                </button>
              <% } else { %>
                <a
                  href="/eventos/<%= evento.id %>/chaves/<%= chaveRapida.chave_id %>/imprimir"
                  target="_blank"
                  class="button button-outline"
                  id="btnImprimirChaveRapida"
                  title="Imprimir chave em branco"
                >
                  <%- include("../partials/icone", { nome: 'documento' }) %> Imprimir Chave (PDF)
                </a>
              <% } %>
            <% } %>

            <% if (!chaveIniciada) { %>
              <% if (inscritos && inscritos.length >= 2 && pode('chaves.gerar')) { %>
                <form id="formGerarChave" action="/eventos/<%= evento.id %>/chaves-rapidas/<%= chaveRapida.id %>/gerar" method="POST" style="display: inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" id="btnGerarChave" class="button <%= chaveRapida.chave_id ? 'button-outline' : 'button-primary' %>">
                    <%= chaveRapida.chave_id ? 'Regerar Chave Eliminatória' : 'Gerar Chave Eliminatória' %>
                  </button>
                </form>
              <% } %>

              <% if (pode('chaves.gerenciar')) { %>
                <form action="/eventos/<%= evento.id %>/chaves-rapidas/<%= chaveRapida.id %>/excluir" method="POST" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja excluir esta chave rápida?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="button button-danger">
                    Excluir
                  </button>
                </form>
              <% } %>
            <% } %>
          </div>
        </div>

        <section class="page-content" style="display: grid; gap: 24px;">
          <% if (chaveIniciada) { %>
            <div class="card" style="border-left: 4px solid var(--color-warning, #d69e2e); background: rgba(214, 158, 46, 0.05); padding: 16px 20px;">
              <strong style="display: block; font-size: 15px; color: var(--color-text);">
                Chave <%= (chaveRapida.status === 'FINALIZADA' || chaveRapida.chave_status === 'FINALIZADA') ? 'Finalizada' : 'em Andamento' %>
              </strong>
              <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--color-text-muted);">
                Esta chave já foi iniciada e as lutas estão em disputa. Novas inscrições ou alterações de competidores estão bloqueadas.
              </p>
            </div>
          <% } else { %>
            <!-- Formulário para adicionar competidor rapidamente -->
            <div class="card">
              <h2 style="font-size: 16px; margin: 0 0 16px 0;">+ Inscrever Competidor nesta Chave Rápida</h2>
              <form id="formAdicionarAtleta" action="/eventos/<%= evento.id %>/chaves-rapidas/<%= chaveRapida.id %>/competidores" method="POST" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div style="flex: 2; min-width: 240px;">
                  <label for="nome" style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px;">
                    Nome do Competidor *
                  </label>
                  <input
                    type="text"
                    id="nome"
                    name="nome"
                    class="form-input"
                    placeholder="Digite o nome completo do atleta"
                    required
                    autofocus
                    style="width: 100%; padding: 8px 12px;"
                  >
                </div>

                <div style="flex: 2; min-width: 220px;">
                  <label for="equipe_id" style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px;">
                    Academia / Equipe (opcional)
                  </label>
                  <select
                    id="equipe_id"
                    name="equipe_id"
                    class="form-select"
                    style="width: 100%; padding: 8px 12px;"
                  >
                    <option value="">Sem academia / Avulso</option>
                    <% if (equipes && equipes.length > 0) { %>
                      <% equipes.forEach(function(eq) { %>
                        <option value="<%= eq.id %>"><%= eq.nome %></option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>

                <div>
                  <button type="submit" id="btnAdicionarAtleta" class="button button-primary" style="height: 38px;">
                    Adicionar Atleta
                  </button>
                </div>
              </form>
            </div>
          <% } %>

          <!-- Lista de competidores cadastrados -->
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div>
                <h2 style="font-size: 16px; margin: 0;">Competidores Inscritos</h2>
                <small style="color: var(--color-text-muted);">Total: <strong><%= inscritos ? inscritos.length : 0 %></strong> atleta(s)</small>
              </div>

              
            </div>

            <% if (!inscritos || inscritos.length === 0) { %>
              <div style="text-align: center; padding: 36px 16px; background: rgba(0,0,0,0.02); border-radius: 4px;">
                <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 600;">Nenhum competidor inscrito ainda</p>
                <p style="margin: 0; font-size: 13px; color: var(--color-text-muted);">
                  Use o campo acima para adicionar os atletas que vão disputar esta chave rápida.
                </p>
              </div>
            <% } else { %>
              <div class="table-container">
                <table class="table">
                  <thead>
                    <tr>
                      <th style="width: 50px;">#</th>
                      <th>Nome do Atleta</th>
                      <th>Academia / Equipe</th>
                      <% if (!chaveIniciada) { %>
                        <th style="width: 90px; text-align: right;">Ações</th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% inscritos.forEach(function(insc, idx) { %>
                      <tr>
                        <td style="color: var(--color-text-muted); font-weight: 600;"><%= idx + 1 %></td>
                        <td>
                          <strong><%= insc.nome %></strong>
                        </td>
                        <td>
                          <% if (insc.equipe_nome) { %>
                            <span class="badge badge-neutral"><%= insc.equipe_nome %></span>
                          <% } else { %>
                            <span style="color: var(--color-text-muted); font-size: 13px;">Sem academia (Avulso)</span>
                          <% } %>
                        </td>
                        <% if (!chaveIniciada) { %>
                          <td style="text-align: right;">
                            <form
                              action="/eventos/<%= evento.id %>/chaves-rapidas/<%= chaveRapida.id %>/competidores/<%= insc.id %>/remover"
                              method="POST"
                              style="display: inline;"
                              onsubmit="return confirm('Remover <%= insc.nome %> desta chave?');"
                            >
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="button button-small button-danger" title="Remover competidor">
                                Remover
                              </button>
                            </form>
                          </td>
                        <% } %>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <% if (!chaveIniciada && inscritos.length === 1) { %>
                <p style="margin-top: 12px; font-size: 12px; color: var(--color-text-muted);">
                  * Cadastre pelo menos mais um competidor para poder gerar a chave eliminatória.
                </p>
              <% } %>
            <% } %>
          </div>
        </section>
      </main>

      <%- include("../chaves/modal-impressao") %>
      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>

    <script>
      (function() {
        var formAdd = document.getElementById('formAdicionarAtleta');
        if (formAdd) {
          var isSubmittingAdd = false;
          formAdd.addEventListener('submit', function(e) {
            if (isSubmittingAdd) {
              e.preventDefault();
              return false;
            }

            var nomeInput = document.getElementById('nome');
            if (nomeInput && !nomeInput.value.trim()) {
              return;
            }

            isSubmittingAdd = true;
            var btn = document.getElementById('btnAdicionarAtleta');
            if (btn) {
              btn.style.pointerEvents = 'none';
              btn.style.opacity = '0.7';
              btn.innerHTML = 'Adicionando...';
              setTimeout(function() {
                btn.disabled = true;
              }, 20);
            }
          });
        }

        var formGerar = document.getElementById('formGerarChave');
        if (formGerar) {
          var isSubmittingGerar = false;
          formGerar.addEventListener('submit', function(e) {
            if (isSubmittingGerar) {
              e.preventDefault();
              return false;
            }
            isSubmittingGerar = true;
            var btn = document.getElementById('btnGerarChave');
            if (btn) {
              btn.style.pointerEvents = 'none';
              btn.style.opacity = '0.7';
              btn.innerHTML = 'Gerando...';
              setTimeout(function() {
                btn.disabled = true;
              }, 20);
            }
          });
        }
      })();
    </script>
  </body>
</html>
