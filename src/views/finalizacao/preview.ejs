<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: `Finalizar ${categoria.nome} - ${evento.nome}`
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <%- include("../partials/trilha", { itens: [{ label: 'Chaves', path: '/chaves' }, { label: categoria ? categoria.nome : chave.nome, path: '/chaves/' + chave.id }, { label: 'Finalizar categoria' }] }) %>

            <h1 class="page-title">
              Finalizar categoria
            </h1>

            <p class="page-subtitle">
              <%= categoria.nome %> &bull; Campeonato: <strong><%= evento.nome %></strong>
            </p>
          </div>
        </div>

        <section class="page-content" style="max-width: 900px;">
          <div class="alert alert-warning" style="margin-bottom: 24px;">
            Confira as colocações e a pontuação antes de finalizar. Após a confirmação, a categoria ficará bloqueada.
          </div>

          <div style="margin-bottom: 28px;">
            <h2 style="font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">
              Pódio Previsto
            </h2>

            <div class="podium-preview" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
              <% const colocados = [podio.primeiro, podio.segundo, podio.terceiro].filter(Boolean); %>
              <% colocados.forEach((colocado, index) => { %>
                <div class="card podium-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; padding: 20px; gap: 8px;">
                  <span class="podium-position" style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #111; color: #fff; padding: 4px 10px; border-radius: 2px;">
                    <%= index + 1 %>º lugar
                  </span>
                  <strong style="font-size: 16px;"><%= colocado.nome %></strong>
                  <span style="font-size: 13px; color: var(--color-text-muted);"><%= colocado.equipe_nome %></span>
                  <span class="podium-points" style="font-size: 13px; font-weight: 700; border: 1px dashed var(--color-border); padding: 4px 8px; border-radius: 2px; margin-top: 4px;">
                    +<%= colocado.pontos %> <%= colocado.pontos === 1 ? 'ponto' : 'pontos' %>
                  </span>
                </div>
              <% }) %>
            </div>

            <% if (!podio.terceiro) { %>
              <p style="font-size: 13px; color: var(--color-text-muted); margin-top: 12px; margin-bottom: 0; font-style: italic;">
                Não haverá terceiro lugar nesta categoria.
              </p>
            <% } %>
          </div>

          <div style="margin-bottom: 28px;">
            <h2 style="font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">
              Resumo de Pontuação por Academia
            </h2>

            <% if (resumoEquipes && resumoEquipes.length > 0) { %>
              <div class="table-container">
                <table class="table table-resumo-pontuacao">
                  <thead>
                    <tr>
                      <th class="col-academia">Academia</th>
                      <th class="col-num">Anterior</th>
                      <th class="col-num">Vitórias</th>
                      <th class="col-num">Pódio</th>
                      <th class="col-num">+ Novos</th>
                      <th class="col-num">Total Final</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% resumoEquipes.forEach((equipe) => { %>
                      <tr>
                        <td class="col-academia" data-label="Academia">
                          <strong><%= equipe.equipe_nome %></strong>
                        </td>
                        <td class="col-num" data-label="Pontos anteriores">
                          <%= equipe.pontos_atuais %>
                        </td>
                        <td class="col-num" data-label="Vitórias nesta chave">
                          <%= equipe.pontos_vitorias > 0 ? '+' + equipe.pontos_vitorias : '-' %>
                        </td>
                        <td class="col-num" data-label="Pódio">
                          <%= equipe.pontos_colocacao > 0 ? '+' + equipe.pontos_colocacao : '-' %>
                        </td>
                        <td class="col-num col-novos" data-label="Novos pontos">
                          <strong>+<%= equipe.novos_pontos %></strong>
                        </td>
                        <td class="col-num col-total" data-label="Total final">
                          <strong><%= equipe.total_apos %></strong>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="card">
                <p style="margin: 0; font-size: 13px; color: var(--color-text-muted);">
                  Nenhuma academia pontuará nesta categoria.
                </p>
              </div>
            <% } %>
          </div>

          <form
            action="/eventos/<%= evento.id %>/chaves/<%= chave.id %>/finalizar"
            method="POST"
            data-confirm="Confirma a finalização desta categoria com as colocações e pontuações apresentadas?"
          >
            <input
              type="hidden"
              name="_csrf"
              value="<%= csrfToken %>"
            >

            <div class="form-actions" style="margin-top: 24px;">
              <a
                href="/eventos/<%= evento.id %>/chaves/<%= chave.id %>"
                class="button button-outline"
              >
                Voltar e conferir
              </a>

              <button
                type="submit"
                class="button button-primary"
              >
                Confirmar finalização
              </button>
            </div>
          </form>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
