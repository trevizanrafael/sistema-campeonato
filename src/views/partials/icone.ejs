<%#
  Ícones SVG inline (traço, 18px). Uso: include("icone", { nome: "inicio" })
%>
<% const n = typeof nome !== 'undefined' ? nome : ''; %>
<svg class="icone" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<% if (n === 'inicio') { %>
  <path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>
<% } else if (n === 'campeonatos') { %>
  <path d="M8 21h8"/><path d="M12 17v4"/><path d="M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3"/><path d="M7 5H4v2a3 3 0 0 0 3 3"/>
<% } else if (n === 'academias') { %>
  <circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7"/><path d="M18 14a6.5 6.5 0 0 1 3.5 6"/>
<% } else if (n === 'faixas') { %>
  <rect x="2" y="9" width="20" height="6" rx="1"/><path d="M15 9v6"/><path d="M18 9v6"/>
<% } else if (n === 'usuarios') { %>
  <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
<% } else if (n === 'visao') { %>
  <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
<% } else if (n === 'pontuacao') { %>
  <path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/>
<% } else if (n === 'categorias') { %>
  <path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h10"/>
<% } else if (n === 'inscricoes') { %>
  <rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6"/><path d="M9 12h6"/><path d="M9 16h3"/>
<% } else if (n === 'chaves') { %>
  <path d="M3 5h5v4H3z"/><path d="M3 15h5v4H3z"/><path d="M8 7h3v10H8"/><path d="M11 12h4"/><path d="M15 10h6v4h-6z"/>
<% } else if (n === 'ranking') { %>
  <path d="M6 21V11"/><path d="M12 21V4"/><path d="M18 21v-6"/>
<% } else if (n === 'auditoria') { %>
  <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
<% } else if (n === 'voltar') { %>
  <path d="M15 18l-6-6 6-6"/>
<% } else if (n === 'alerta') { %>
  <path d="M12 3 2 20h20L12 3z"/><path d="M12 10v4"/><path d="M12 17h.01"/>
<% } else if (n === 'check') { %>
  <path d="M5 12.5l4.5 4.5L19 7"/>
<% } else if (n === 'seta') { %>
  <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
<% } else if (n === 'documento') { %>
  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M8.5 12.5h7"/><path d="M8.5 16.5h7"/><path d="M12 11v8"/>
<% } else if (n === 'download') { %>
  <path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/>
<% } else if (n === 'upload') { %>
  <path d="M12 16V5"/><path d="M7 10l5-5 5 5"/><path d="M5 20h14"/>
<% } else if (n === 'busca') { %>
  <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
<% } %>
</svg>
