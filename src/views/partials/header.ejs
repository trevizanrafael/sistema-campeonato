<header class="app-header">
  <button
    type="button"
    class="sidebar-toggle"
    id="sidebarToggle"
    aria-label="Abrir ou fechar menu"
    aria-expanded="false"
  >
    ☰
  </button>

  <a href="/" class="app-logo">
    <% if (typeof brand !== 'undefined' && brand && brand.logoHorizontal) { %>
      <img src="<%= brand.logoHorizontal %>" alt="<%= brand.nome %>" class="app-logo-image">
    <% } else { %>
      <%= (typeof brand !== 'undefined' && brand && brand.nomeSistema) ? brand.nomeSistema : 'Sistema de Lutas' %>
    <% } %>
  </a>

  <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
  <div class="header-user">
    <span class="header-user-name">
      <%= usuarioLogado.nome %>
    </span>

    <form action="/logout" method="POST">
      <input
        type="hidden"
        name="_csrf"
        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
      >

      <button type="submit" class="button button-outline button-small">
        Sair
      </button>
    </form>
  </div>
  <% } %>
</header>
