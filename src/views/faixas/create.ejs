<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (typeof brand !== 'undefined' && brand.id) ? brand.id : 'base' %>">
  <head>
    <%- include("../partials/head", {
      titulo: titulo || "Nova faixa"
    }) %>
  </head>

  <body>
    <div class="app">
      <%- include("../partials/header") %>
      <%- include("../partials/sidebar") %>

      <main class="main-content">
        <%- include("../partials/messages") %>

        <div class="page-header">
          <div>
            <h1 class="page-title">Nova faixa</h1>
            <p class="page-subtitle">A nova faixa sera adicionada ao final da ordem atual.</p>
          </div>
        </div>

        <section class="page-content">
          <div class="card form-card">
            <form action="/faixas" method="POST">
              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <%- include("_form", {
                faixa,
                erros
              }) %>

              <div class="form-actions">
                <a href="/faixas" class="button button-outline">
                  Cancelar
                </a>

                <button type="submit" class="button button-primary">
                  Cadastrar faixa
                </button>
              </div>
            </form>
          </div>
        </section>
      </main>

      <%- include("../partials/footer") %>
    </div>

    <%- include("../partials/scripts") %>
  </body>
</html>
